NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
ADMIN_DASHBOARD_KEY=change-me
STRAPI_DASHBOARD_KEY=change-me

# Public address of the site (canonical URLs, sitemap, share images, llms.txt). Defaults to https://kodrum.mk.
# SITE_URL=https://kodrum.mk

# Strapi base URL on the server (falls back to NEXT_PUBLIC_STRAPI_URL).
# STRAPI_URL=http://localhost:1337

# Google Analytics 4 measurement id (no analytics when unset).
# NEXT_PUBLIC_GA_ID=

# Where contact-form messages go: Mattermost first, Telegram as the fallback.
# MATTERMOST_WEBHOOK_URL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_TOPIC_ID=
